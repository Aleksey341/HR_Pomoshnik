# Локальная разработка: скопируйте в .env. Реальные секреты не коммитьте.

# Внешние API. В production задаются только как Environment Variables backend-сервиса.
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=none

# Managed access: храните только SHA-256 пользовательских кодов через запятую.
# Код HRP-... создаётся: python scripts/make_access_code.py
MANAGED_ACCESS_CODE_HASHES=

# Разрешённые браузерные Origin для managed gateway.
# Для GitHub Pages достаточно https://aleksey341.github.io
CORS_ORIGINS=https://aleksey341.github.io,http://127.0.0.1:8765,http://localhost:8765

# Локальный Flask-сервер
PORT=8765
RATE_LIMIT_PER_MINUTE=60

# Скопируйте в .env и подставьте свои значения (файл .env не коммитьте).
# server.py загружает .env автоматически (python-dotenv).

# Ключ Firecrawl (fc-…). Если задан — можно не вводить в UI.
FIRECRAWL_API_KEY=

# Ключ OpenAI (sk-…). Нужен только для вкладки AI-анализа через локальный прокси.
OPENAI_API_KEY=

# Порт локального сервера (по умолчанию 8765)
PORT=8765

# Разрешённые Origin для CORS (через запятую)
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Лимит API-запросов на IP на endpoint (в минуту)
RATE_LIMIT_PER_MINUTE=60
